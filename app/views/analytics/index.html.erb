<h1 class="title">Analytics for Your Posts</h1>
<p class="subtitle has-text-grey">Track comments, visitors, and engagement on posts authored by <%= current_member.name %></p>
<div class="notification is-info is-light mb-4">
  <p><strong>📊 What's shown here:</strong></p>
  <ul>
    <li>• Comments made on <strong>your posts</strong> by all users</li>
    <li>• Visitors who viewed <strong>your posts</strong></li>
    <li>• Average length of comments on <strong>your posts</strong></li>
    <li>• Browser and device statistics from <strong>your post visitors</strong></li>
  </ul>
</div>
<div data-controller="chart">
  <%= form_with(url: analytics_url, method: :get, class: "is-flex is-justify-content-center my-4") do |form| %>
    <div class="is-flex is-flex-wrap-wrap is-align-items-center">
      <%= form.date_field :start_date,
        value: @start_date,
        class: "input is-primary",
        data: {
          chart_target: "startDate",
          action: "change->chart#new_range"
        },
        placeholder: "Select start date" %>
      <span class="mx-auto">to</span>
      <%= form.date_field :end_date,
        value: @end_date,
        class: "input is-primary",
        data: {
          chart_target: "endDate",
          action: "change->chart#new_range"
        },
        placeholder: "Select end date" %>
      <%= form.submit "Ok",
        class: "is-hidden",
        data: {
          chart_target: "btnSubmit"
        } %>
    </div>
  <% end %>

  <% %w(counter_analytics length_analytics unique_analytics browser_analytics).each do |analytics| %>
    <%= render "broadcast", analytics: analytics %>
  <% end %>

  <%= render "chart", title: "Comments on Your Posts", target: "counter" %>
  <%= render "chart", title: "Average Comment Length on Your Posts", target: "length" %>
  <%= render "chart", title: "Unique Visitors to Your Posts", target: "unique" %>
  <%= render "chart", title: "Devices Used by Your Post Visitors", target: "devices" %>
  <%= render "chart", title: "Platforms Used by Your Post Visitors", target: "platforms" %>
</div>

<%= link_to "Back", root_path, class: "button is-primary mt-5" %>
